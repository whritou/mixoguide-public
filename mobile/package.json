    "@tanstack/react-query": "^5.100.5",
    "axios": "^1.15.2",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
