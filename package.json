{
  "name": "mixoguide",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seeder/seed_light.ts",
    "db:seed:cocktaildb": "tsx prisma/seeder/seedCocktailDB.ts",
    "db:seed:complexity": "tsx prisma/seeder/seedCocktailDB.ts --update-complexity",
    "db:seed:complexity:prod": "node dist/prisma/seeder/seedCocktailDB.js --update-complexity",
    "db:seed:complexity:prod:dry-run": "node dist/prisma/seeder/seedCocktailDB.js --update-complexity --dry-run",
    "db:seed:unit": "tsx prisma/seeder/update-ingredient-units.ts",
    "db:ingredients:simplify": "tsx prisma/seeder/simplifyIngredients.ts",
    "db:ingredients:simplify:prod": "node dist/prisma/seeder/simplifyIngredients.js",
    "db:seed:export": "tsx prisma/seeder/seedCocktailDB.ts --export",
    "db:seed:export:simple": "tsx prisma/seeder/seedCocktailDB.ts --export-simple",
    "db:update:ingredient-images": "tsx prisma/seeder/updateIngredientImages.ts",
    "db:reset": "prisma migrate reset",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:api": "vitest run tests/integration --exclude tests/integration/db/**",
    "test:db": "tsx tests/integration/db/run-db-tests.ts",
    "test:webapp": "npx playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage --exclude tests/integration/db/**",
    "test:all": "npm run test:coverage:check && npm run test:db && npm run test:webapp && npm --prefix mobile run test:coverage:check"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.0.1",
    "@marsidev/react-turnstile": "^1.5.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.12",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.0.8",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.6.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^16.5.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.509.0",
    "lucide-react-native": "^1.12.0",
    "motion": "^12.38.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "next-cloudinary": "^6.16.0",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "prettier": "^3.5.3",
    "prisma": "^6.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.4",
    "react-native-svg": "^15.15.4",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.2.9",
    "zod": "^3.25.23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.59.1",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@types/node": "^20.17.46",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "node-mocks-http": "^1.17.2",
    "tailwindcss": "^4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
