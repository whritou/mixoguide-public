# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist
/prisma-cli

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ─── SECRETS & CREDENTIALS ────────────────────────────────────────────────────
# Google Play service account key (contains private key + credentials)
google-play-service-account.json
mobile/google-play-service-account.json

# Android signing keys (keystores) — never commit production keys
*.jks
*.keystore

# Firebase/Google Cloud credentials
mobile/google-services.json
# Android local SDK properties (do not commit local paths)
mobile/android/local.properties
android/local.properties

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/.claude/

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# brainstorming mockups
.superpowers/

# IDE
.idea/
coverage/
.claude/worktrees/
