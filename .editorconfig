root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,mjs,cjs}]
# Existing code mixes 2- and 4-space indentation; keep whatever the file uses.
indent_size = unset

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
